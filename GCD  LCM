  long long lcm(long long a, long long b) { return (a * b) / __gcd(a, b); }

    long long GCD(int idx, vector<int>& nums) {
        int g = -1;
        for (int i = 0; i < nums.size(); ++i) {
            if (idx != i) {
                g =(g==-1)?nums[i]: __gcd(g, nums[i]);
            };
        }
        return g;
    }

    long long LCM(int idx, vector<int>& nums) {
        long long l = -1;
        for (int i = 0; i < nums.size(); ++i) {
            if (idx != i) {
                l = (l==-1)? nums[i] : lcm(l, nums[i]);
            };
        }
        return l;
    }

    long long maxScore(vector<int>& nums) {
        int n = nums.size();
        long long ans = 0;
        for (int i = 0; i <= n; i++) {
            for (int j = 0; j < n; j++) {
                long long allGCD = GCD(i, nums);
                long long allLCM = LCM(i, nums);
                // cout << allGCD << " " << allLCM << endl;
                ans = max(ans, allGCD * 1LL * allLCM);
            }
        }

        return ans;
    }
};
